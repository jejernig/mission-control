# Issue Detection Service Configuration

# Cron schedule for detection runs (default: every 15 minutes)
# Format: "minute hour day month weekday"
# Examples:
#   */15 * * * * = Every 15 minutes
#   0 * * * *    = Every hour
#   0 */4 * * *  = Every 4 hours
DETECTION_SCHEDULE=*/15 * * * *

# Hours of inactivity before a task is considered stuck (default: 4)
STUCK_TASK_HOURS=4

# Minutes before re-detecting the same issue (default: 60)
COOLDOWN_MINUTES=60

# Path to self-healing database (default: ./self-healing.db)
SELF_HEALING_DB_PATH=./self-healing.db

# Path to Mission Control database (default: ./mission-control.db)
MISSION_CONTROL_DB_PATH=./mission-control.db

# Auto-start service on launch (default: false)
AUTO_START=false
